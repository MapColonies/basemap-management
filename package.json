{
  "name": "basemap-management",
  "version": "1.1.1",
  "description": "Management of basemap configurations and layers",
  "main": "./src/index.ts",
  "scripts": {
    "test:unit": "vitest run --coverage.enabled=false --project unit",
    "test:integration": "vitest run --coverage.enabled=false --project integration",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "prelint:fix": "npm run format:fix",
    "prelint": "npm run format",
    "lint:openapi": "redocly lint openapi3.yaml",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prebuild": "npm run clean && npm run generate:openapi-types",
    "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json && npm run assets:copy",
    "start": "npm run build && cd dist && node --import ./instrumentation.mjs ./index.js",
    "start:dev": "npm run build && cd dist && cross-env CONFIG_OFFLINE_MODE=true  node --enable-source-maps --import ./instrumentation.mjs ./index.js",
    "start:mock": "npm run build && cd dist && cross-env CONFIG_OFFLINE_MODE=true BASEMAP_MOCK_DATA=true  node --enable-source-maps --import ./instrumentation.mjs ./index.js",
    "assets:copy": "copyfiles -f ./config/* ./dist/config && copyfiles -f ./openapi3.yaml ./dist/ && copyfiles ./package.json dist",
    "clean": "rimraf dist",
    "generate:openapi-types": "openapi-generators generate types ./openapi3.yaml ./src/openapi.d.ts --format --add-typed-request-handler",
    "postinstall": "patch-package",
    "prepare": "node .husky/install.mjs",
    "helm-update": "helm dependency update helm",
    "helm-assets": "npm run helm-update && tar -xzvf ./helm/charts/helm-common*.tgz --strip-components=1 helm-common/schemas",
    "helm-install": "npm run helm-update && helm install -f 'helm/global.yaml' -f 'helm/values.yaml' basemap-management helm",
    "helm-uninstall": "helm uninstall basemap-management",
    "migrate:basemaps": "node scripts/migrateBasemaps.js",
    "build:migration": "node scripts/buildMigrationBundle.js",
    "generate:config-server-schema": "node scripts/generateConfigServerSchema.js"
  },
  "directories": {
    "test": "tests"
  },
  "author": "MapColonies",
  "license": "ISC",
  "dependencies": {
    "@godaddy/terminus": "^4.12.1",
    "@map-colonies/app-shared": "^0.2.5",
    "@map-colonies/config": "^4.0.1",
    "@map-colonies/csw-client": "^1.3.0",
    "@map-colonies/error-express-handler": "^4.0.0",
    "@map-colonies/express-access-log-middleware": "^5.0.0",
    "@map-colonies/js-logger": "^5.0.0",
    "@map-colonies/mc-model-types": "^19.2.3",
    "@map-colonies/openapi-express-viewer": "^5.0.0",
    "@map-colonies/prometheus": "^1.0.0",
    "@map-colonies/read-pkg": "^2.0.0",
    "@map-colonies/schemas": "^1.26.0",
    "@map-colonies/tracing": "^1.0.0",
    "@map-colonies/tracing-utils": "^2.0.0",
    "@map-colonies/types": "^1.12.5",
    "@map-colonies/wmts-client": "^0.2.0",
    "@opentelemetry/api": "^1.9.1",
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "express-openapi-validator": "^5.6.2",
    "http-status-codes": "^2.3.0",
    "jszip": "^3.10.1",
    "multer": "^2.0.2",
    "patch-package": "^8.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0",
    "zod": "~3.25.76"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@commitlint/cli": "^21.2.3",
    "@map-colonies/commitlint-config": "^2.0.1",
    "@map-colonies/eslint-config": "^9.0.0",
    "@map-colonies/eslint-plugin": "^1.0.0",
    "@map-colonies/openapi-express-types": "^0.2.0",
    "@map-colonies/openapi-generators": "^0.2.0",
    "@map-colonies/openapi-supertest": "^0.2.0",
    "@map-colonies/prettier-config": "^1.0.0",
    "@map-colonies/tsconfig": "^2.0.0",
    "@redocly/cli": "^2.60.0",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.2.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yargs": "17.0.35",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/eslint-plugin": "1.6.27",
    "@vitest/ui": "^4.1.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "jest-openapi": "^0.14.2",
    "js-yaml": "^4.3.2",
    "prettier": "^3.9.9",
    "pretty-quick": "^4.2.2",
    "rimraf": "^6.1.3",
    "rolldown": "~1.2.16",
    "supertest": "^7.2.2",
    "tsc-alias": "^1.9.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "zod-to-json-schema": "^3.25.2"
  }
}
