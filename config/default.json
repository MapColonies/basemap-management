{
  "openapiConfig": {
    "filePath": "./openapi3.yaml",
    "basePath": "/docs",
    "rawPath": "/api",
    "uiPath": "/api"
  },
  "telemetry": {
    "metrics": {},
    "tracing": {
      "isEnabled": false
    },
    "shared": {},
    "logger": {
      "level": "info",
      "prettyPrint": false,
      "opentelemetryOptions": {
        "enabled": false
      }
    }
  },
  "server": {
    "port": 8081,
    "request": {
      "payload": {
        "limit": "1mb"
      }
    },
    "response": {
      "compression": {
        "enabled": true,
        "options": null
      }
    }
  },
  "rasterCatalog": {
    "url": "https://raster-serving-pycsw-private-nginx-route-manual-integration.apps.j1lk3njp.eastus.aroapp.io/api/raster/v1"
  },
  "mapServer": {
    "url": "https://raster-serving-int-mapproxy-nginx-route-manual-integration.apps.j1lk3njp.eastus.aroapp.io/api/raster/v1"
  }
}
