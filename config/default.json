{
  "openapiConfig": {
    "filePath": "./openapi3.yaml",
    "basePath": "/docs",
    "rawPath": "/api",
    "uiPath": "/api"
  },
  "telemetry": {
    "metrics": {},
    "tracing": {
      "isEnabled": false
    },
    "shared": {},
    "logger": {
      "level": "info",
      "prettyPrint": false,
      "opentelemetryOptions": {
        "enabled": false
      }
    }
  },
  "server": {
    "port": 8081,
    "request": {
      "payload": {
        "limit": "1mb"
      }
    },
    "response": {
      "compression": {
        "enabled": true,
        "options": null
      }
    }
  },
  "configServer": {
    "url": "http://config-server",
    "configName": "basemaps",
    "schemaId": "https://mapcolonies.com/common/basemaps/v1"
  },
  "rasterCatalog": {
    "url": "http://raster-catalog",
    "exposureType": "ROUTE"
  },
  "mapServer": {
    "url": "http://mapproxy",
    "exposureType": "ROUTE"
  },
  "accessToken": {
    "attributeName": "token",
    "injectionType": "queryParam",
    "tokenValue": ""
  },
  "uploadLimits": {
    "importPackageMaxSizeBytes": 10485760
  }
}
